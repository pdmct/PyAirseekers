#!/usr/bin/env python3
"""
Airseekers Tron CLI - Control your robot mower from the command line.
"""

import asyncio
import argparse
import json
import sys
import os
from datetime import datetime, timezone, timedelta

import aiohttp

# Add parent dir for imports
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from api_client import AirseekersAPI

AEST = timezone(timedelta(hours=11))

TASK_STATES = {0: "Idle", 1: "Mowing", 2: "Returning", 3: "Docked", 4: "Paused", 5: "Error"}
TASK_TYPES = {0: "None", 1: "Auto Mow", 2: "Manual", 3: "Scheduled"}


def format_time(ts):
    """Format unix timestamp to readable AEST."""
    if not ts:
        return "Unknown"
    return datetime.fromtimestamp(ts, tz=AEST).strftime("%Y-%m-%d %H:%M:%S AEDT")

def format_lock_status(status):
    return {0: "🔓 Unlocked", 1: "🔒 Locked", 2: "🔓 Unlocked"}.get(status, f"Unknown ({status})")

def format_online(status):
    if isinstance(status, bool):
        return "🟢 Online" if status else "⚫ Offline"
    return {0: "⚫ Offline", 1: "🟢 Online"}.get(status, f"Unknown ({status})")


class TronCLI:
    def __init__(self, email, password):
        self.email = email
        self.password = password
        self.session = None
        self.api = None
        self._sn = None

    async def connect(self):
        self.session = aiohttp.ClientSession()
        self.api = AirseekersAPI(self.email, self.password, session=self.session)
        await self.api.get_server_host()
        await self.api.login()

    async def close(self):
        if self.session:
            await self.session.close()

    async def get_device(self):
        """Get first device."""
        devices = await self.api.get_devices()
        if not devices.list:
            print("❌ No devices found")
            return None
        self._sn = devices.list[0]['sn']
        return devices.list[0]

    async def get_sn(self):
        if not self._sn:
            device = await self.get_device()
            if not device:
                return None
        return self._sn

    async def cmd_status(self, args):
        """Show full mower status."""
        device = await self.get_device()
        if not device:
            return

        sn = device['sn']
        resp = await self.api._make_request("GET", f"/api/web/device/full-status?sn={sn}")
        if resp.code != 0:
            print(f"❌ Failed to get status: {resp.msg}")
            return

        d = resp.data

        # Battery
        bat = d.get('battery_status', {})
        # Network
        net = d.get('net_info', {})
        # Online
        online = d.get('online_status', {})
        # RTK
        rtk = d.get('rtk_status', {})
        # Task
        task = d.get('task_status', {})
        # Version
        ver = d.get('version', {})
        # Config
        cfg_resp = await self.api._make_request("GET", f"/api/web/device/config?sn={sn}")
        cfg = cfg_resp.data.get('configs', {}) if cfg_resp.code == 0 else {}

        task_state = TASK_STATES.get(task.get('state'), f"Unknown ({task.get('state')})")
        task_type = TASK_TYPES.get(task.get('type'), f"Unknown ({task.get('type')})")

        print("🤖 Airseekers Tron — Full Status")
        print("=" * 50)

        print(f"\n📡 Connection")
        print(f"  Status:         {format_online(online.get('status', False))}")
        print(f"  WiFi SSID:      {net.get('wifi_ssid', 'N/A')}")
        print(f"  WiFi IP:        {net.get('wifi_ip', 'N/A')}")
        print(f"  WiFi Signal:    {net.get('wifi_dbm', 'N/A')} dBm")
        print(f"  4G IP:          {net.get('wireless_4g_ip', 'N/A')}")
        print(f"  SIM (ICCID):    {net.get('sim_iccid', 'N/A')}")

        print(f"\n🔋 Battery")
        print(f"  Charge:         {bat.get('battery_percentage', '?')}%")
        print(f"  Temperature:    {bat.get('battery_temperature', '?')}°C")
        print(f"  Error:          {'None' if bat.get('battery_error') == 0 else bat.get('battery_error')}")

        print(f"\n📍 GPS / RTK")
        print(f"  Fix Type:       {rtk.get('rtk_status', 'N/A')}")
        print(f"  Satellites:     {rtk.get('num_satellites_used', '?')}/{rtk.get('num_satellites', '?')}")
        print(f"  Latitude:       {rtk.get('robot_pose_lat', 'N/A')}")
        print(f"  Longitude:      {rtk.get('robot_pose_lon', 'N/A')}")
        print(f"  Heading (yaw):  {rtk.get('robot_pose_yaw', 'N/A')}")
        print(f"  LoRa Signal:    {rtk.get('lora_rssi_dbm', 'N/A')} dBm")

        print(f"\n🌿 Task")
        print(f"  State:          {task_state}")
        print(f"  Type:           {task_type}")
        print(f"  Started:        {task.get('start_time', 'N/A')}")
        print(f"  Run Time:       {task.get('run_time', 'N/A')}")
        print(f"  Area Done:      {task.get('total_area', 0)} m²")
        print(f"  Area Left:      {task.get('remaining_area', 0)} m²")

        print(f"\n⚙️  Config")
        print(f"  Lock:           {format_lock_status(int(cfg.get('DeviceLock', '0')))}")
        print(f"  Volume:         {cfg.get('SetVolume', '?')}%")
        print(f"  Light:          {cfg.get('SetLightBrightness', '?')}%")
        print(f"  NRTK:           {'Enabled' if cfg.get('EnableNRTK') == '1' else 'Disabled'}")
        print(f"  Dark Mode:      {cfg.get('SetDarkMode', 'Off') or 'Off'}")

        print(f"\n🔧 Firmware")
        print(f"  Package:        {ver.get('mower_package', 'N/A')}")
        print(f"  Chassis:        {ver.get('chassis_board', 'N/A')}")
        print(f"  Cutter:         {ver.get('cutter_board', 'N/A')}")
        print(f"  RTK Board:      {ver.get('rtk_board', 'N/A')}")
        print(f"  Voice:          {ver.get('voice_language', 'N/A')}")

        print(f"\n🆔 Device")
        print(f"  SN:             {sn}")
        print(f"  Device ID:      {device['id']}")

    async def cmd_battery(self, args):
        """Show battery status."""
        sn = await self.get_sn()
        if not sn:
            return
        resp = await self.api._make_request("GET", f"/api/web/device/full-status?sn={sn}")
        if resp.code != 0:
            print(f"❌ {resp.msg}")
            return
        bat = resp.data.get('battery_status', {})
        pct = bat.get('battery_percentage', 0)
        temp = bat.get('battery_temperature', '?')
        bars = '█' * (pct // 5) + '░' * (20 - pct // 5)
        print(f"🔋 [{bars}] {pct}%  ({temp}°C)")

    async def cmd_gps(self, args):
        """Show GPS location."""
        sn = await self.get_sn()
        if not sn:
            return
        resp = await self.api._make_request("GET", f"/api/web/device/full-status?sn={sn}")
        if resp.code != 0:
            print(f"❌ {resp.msg}")
            return
        rtk = resp.data.get('rtk_status', {})
        lat = rtk.get('robot_pose_lat', 0)
        lon = rtk.get('robot_pose_lon', 0)
        print(f"📍 GPS Position")
        print(f"  Lat:        {lat}")
        print(f"  Lon:        {lon}")
        print(f"  Fix:        {rtk.get('rtk_status', 'N/A')}")
        print(f"  Satellites: {rtk.get('num_satellites_used', '?')}/{rtk.get('num_satellites', '?')}")
        if lat and lon:
            print(f"\n  🗺️  https://www.google.com/maps?q={lat},{lon}")

