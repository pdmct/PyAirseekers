    async def cmd_history(self, args):
        """Show task history."""
        sn = await self.get_sn()
        if not sn:
            return
        resp = await self.api._make_request("GET", f"/api/web/device/task-record/list?sn={sn}")
        if resp.code != 0:
            print(f"❌ {resp.msg}")
            return

        records = resp.data if isinstance(resp.data, list) else resp.data.get('list', []) if isinstance(resp.data, dict) else []
        limit = args.limit or 10
        print(f"📋 Task History (last {limit})")
        print("=" * 50)
        for r in records[:limit]:
            print(json.dumps(r, indent=2))
            print()

    async def cmd_maps(self, args):
        """List maps."""
        sn = await self.get_sn()
        if not sn:
            return
        resp = await self.api._make_request("GET", f"/api/web/device/map?sn={sn}")
        if resp.code != 0:
            print(f"❌ Failed to get maps: {resp.msg}")
            return
        maps = resp.data if isinstance(resp.data, list) else []
        print(f"🗺️  Maps ({len(maps)} found)")
        print("=" * 40)
        for m in maps:
            print(f"  ID:   {m['mapId']}")
            print(f"  Name: {m.get('nick_name', m.get('mapName', 'Unknown'))}")
            geo = m.get('geoData', {})
            features = geo.get('features', [])
            print(f"  Features: {len(features)}")
            for i, f in enumerate(features):
                geom = f.get('geometry', {})
                coords = geom.get('coordinates', [])
                print(f"    [{i}] {len(coords)} points")
            print()

    async def cmd_map_export(self, args):
        """Export map data to JSON."""
        sn = await self.get_sn()
        if not sn:
            return
        resp = await self.api._make_request("GET", f"/api/web/device/map?sn={sn}")
        if resp.code != 0:
            print(f"❌ Failed to get maps: {resp.msg}")
            return
        outfile = args.output or f"tron_map_{sn}.json"
        with open(outfile, 'w') as f:
            json.dump(resp.data, f, indent=2)
        print(f"✅ Map data exported to {outfile}")

    async def cmd_config(self, args):
        """Show or set config."""
        sn = await self.get_sn()
        if not sn:
            return

        if args.set_key and args.set_value:
            resp = await self.api._make_request("POST", "/api/web/device/config", {
                "sn": sn, "key": args.set_key, "value": args.set_value
            })
            if resp.code == 0:
                print(f"✅ Set {args.set_key} = {args.set_value}")
            else:
                print(f"❌ {resp.msg}")
            return

        resp = await self.api._make_request("GET", f"/api/web/device/config?sn={sn}")
        if resp.code != 0:
            print(f"❌ {resp.msg}")
            return
        print("⚙️  Config")
        print("=" * 40)
        for k, v in resp.data.get('configs', {}).items():
            print(f"  {k}: {v}")

    async def cmd_notifications(self, args):
        """Show notifications."""
        sn = await self.get_sn()
        if not sn:
            return
        resp = await self.api._make_request("GET", f"/api/web/device/notify/list?sn={sn}")
        if resp.code != 0:
            print(f"❌ {resp.msg}")
            return
        print("🔔 Notifications")
        print("=" * 40)
        data = resp.data
        if isinstance(data, list):
            for n in data[:20]:
                print(json.dumps(n, indent=2))
        else:
            print(json.dumps(data, indent=2))

    async def cmd_raw(self, args):
        """Make a raw API request."""
        method = args.method.upper()
        endpoint = args.endpoint
        data = json.loads(args.data) if args.data else None
        if data:
            resp = await self.api._make_request(method, endpoint, data)
        else:
            resp = await self.api._make_request(method, endpoint)
        print(f"Code: {resp.code} | Msg: {resp.msg}")
        if resp.data:
            print(json.dumps(resp.data, indent=2))

    async def cmd_mqtt_info(self, args):
        """Show MQTT connection info."""
        certs = await self.api.get_iot_certificates()
        print("📡 MQTT Connection Info")
        print("=" * 40)
        print(f"  Broker:      {certs.mqtt_broker}")
        print(f"  Client ID:   {certs.mqtt_client_id}")
        print(f"  CA cert:     {len(certs.ca)} bytes")
        print(f"  Client cert: {len(certs.cert_key)} bytes")
        print(f"  Private key: {len(certs.private_key)} bytes")
        if args.export:
            os.makedirs(args.export, exist_ok=True)
            for name, content in [("ca.crt", certs.ca), ("cert.pem", certs.cert_key), ("key.pem", certs.private_key)]:
                with open(os.path.join(args.export, name), 'w') as f:
                    f.write(content)
            with open(os.path.join(args.export, "mqtt_config.json"), 'w') as f:
                json.dump({"broker": certs.mqtt_broker, "client_id": certs.mqtt_client_id}, f, indent=2)
            print(f"\n✅ Certificates exported to {args.export}/")

    async def cmd_watch(self, args):
        """Poll mower status every N seconds."""
        interval = args.interval or 30
        print(f"👀 Watching mower status (every {interval}s, Ctrl+C to stop)\n")
        sn = await self.get_sn()
        if not sn:
            return
        try:
            while True:
                resp = await self.api._make_request("GET", f"/api/web/device/full-status?sn={sn}")
                if resp.code == 0:
                    d = resp.data
                    ts = datetime.now(tz=AEST).strftime("%H:%M:%S")
                    online = "🟢" if d.get('online_status', {}).get('status') else "⚫"
                    bat = d.get('battery_status', {}).get('battery_percentage', '?')
                    task = d.get('task_status', {})
                    state = TASK_STATES.get(task.get('state'), '?')
                    rtk = d.get('rtk_status', {})
                    sats = rtk.get('num_satellites_used', '?')
                    fix = rtk.get('rtk_status', '?')
                    net = d.get('net_info', {})
                    wifi = net.get('wifi_dbm', '?')
                    print(f"[{ts}] {online} 🔋{bat}% 🌿{state} 📡{fix}({sats}sat) WiFi:{wifi}dBm")
                await asyncio.sleep(interval)
        except KeyboardInterrupt:
            print("\n👋 Stopped watching")

