def main():
    parser = argparse.ArgumentParser(
        description="🤖 Airseekers Tron CLI",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Commands:
  status           Full mower status (battery, GPS, task, config, firmware)
  battery          Battery level
  gps              GPS position with Google Maps link
  start            Start mowing
  stop             Stop mowing
  pause            Pause mowing
  resume           Resume mowing
  dock             Return to dock
  lock             Lock mower
  unlock           Unlock mower
  config           Show config (or set with --key/--value)
  maps             List maps
  map-export       Export map data to JSON
  history          Task history
  notifications    Show notifications
  watch            Live status polling
  mqtt-info        MQTT broker info
  endpoints        List all known API endpoints
  raw              Raw API request

Examples:
  tron status
  tron battery
  tron gps
  tron start
  tron stop
  tron dock
  tron watch -i 10
  tron config --key SetVolume --value 50
  tron raw GET /api/web/device/full-status?sn=YOUR_SN
        """
    )

    parser.add_argument('--email', default=os.environ.get('AIRSEEKERS_EMAIL'),
                        help='Airseekers account email (or AIRSEEKERS_EMAIL env)')
    parser.add_argument('--password', default=os.environ.get('AIRSEEKERS_PASSWORD'),
                        help='Airseekers account password (or AIRSEEKERS_PASSWORD env)')

    sub = parser.add_subparsers(dest='command', help='Command')

    sub.add_parser('status', help='Full mower status')
    sub.add_parser('battery', help='Battery level')
    sub.add_parser('gps', help='GPS position')
    sub.add_parser('start', help='Start mowing')
    sub.add_parser('stop', help='Stop mowing')
    sub.add_parser('pause', help='Pause mowing')
    sub.add_parser('resume', help='Resume mowing')
    sub.add_parser('dock', help='Return to dock')
    sub.add_parser('lock', help='Lock mower')
    sub.add_parser('unlock', help='Unlock mower')

    p_cfg = sub.add_parser('config', help='Show/set config')
    p_cfg.add_argument('--key', dest='set_key', help='Config key to set')
    p_cfg.add_argument('--value', dest='set_value', help='Config value to set')

    sub.add_parser('maps', help='List maps')

    p_export = sub.add_parser('map-export', help='Export map data')
    p_export.add_argument('-o', '--output', help='Output filename')

    p_hist = sub.add_parser('history', help='Task history')
    p_hist.add_argument('-n', '--limit', type=int, default=10, help='Number of records')

    sub.add_parser('notifications', help='Show notifications')

    p_watch = sub.add_parser('watch', help='Live status polling')
    p_watch.add_argument('-i', '--interval', type=int, default=30, help='Poll interval (seconds)')

    p_mqtt = sub.add_parser('mqtt-info', help='MQTT broker info')
    p_mqtt.add_argument('-e', '--export', help='Export certs to directory')

    sub.add_parser('endpoints', help='List all known API endpoints')

    p_raw = sub.add_parser('raw', help='Raw API request')
    p_raw.add_argument('method', help='HTTP method')
    p_raw.add_argument('endpoint', help='API endpoint')
    p_raw.add_argument('-d', '--data', help='JSON body')

    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        return

    email = args.email
    password = args.password

    if not email or not password:
        print("❌ Need --email/--password or AIRSEEKERS_EMAIL/AIRSEEKERS_PASSWORD env vars")
        sys.exit(1)

    cli = TronCLI(email, password)

    cmd_map = {
        'status': cli.cmd_status,
        'battery': cli.cmd_battery,
        'gps': cli.cmd_gps,
        'start': cli.cmd_task_start,
        'stop': cli.cmd_task_stop,
        'pause': cli.cmd_task_pause,
        'resume': cli.cmd_task_resume,
        'dock': cli.cmd_dock,
        'lock': cli.cmd_lock,
        'unlock': cli.cmd_unlock,
        'config': cli.cmd_config,
        'maps': cli.cmd_maps,
        'map-export': cli.cmd_map_export,
        'history': cli.cmd_history,
        'notifications': cli.cmd_notifications,
        'watch': cli.cmd_watch,
        'mqtt-info': cli.cmd_mqtt_info,
        'endpoints': cli.cmd_endpoints,
        'raw': cli.cmd_raw,
    }

    async def run():
        await cli.connect()
        try:
            await cmd_map[args.command](args)
        finally:
            await cli.close()

    asyncio.run(run())


if __name__ == "__main__":
    main()
